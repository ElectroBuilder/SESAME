<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sesame.Deck.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#05070A"/>
      <Setter Property="Foreground" Value="#F4FBFC"/>
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#F4FBFC"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#121C26"/>
      <Setter Property="Foreground" Value="#F4FBFC"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderBrush" Value="#1E4A58"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#163C48"/>
      <Setter Property="BorderBrush" Value="#00D9F5"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#00D9F5"/>
      <Setter Property="Foreground" Value="#041016"/>
      <Setter Property="BorderBrush" Value="#00D9F5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#121C26"/>
      <Setter Property="Foreground" Value="#F4FBFC"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#123844"/>
    </Style>
    <Style Selector="Button.tile">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="#0B1218"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="28"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="BorderBrush" Value="#1E4A58"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.tile:focus">
      <Setter Property="Background" Value="#123844"/>
      <Setter Property="BorderBrush" Value="#00D9F5"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
  </Application.Styles>
</Application>
