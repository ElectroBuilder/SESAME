<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BgColor">#E8F2F6</Color>
  <Color x:Key="PanelColor">#F7FBFC</Color>
  <Color x:Key="PanelAltColor">#D7E8EE</Color>
  <Color x:Key="BorderColor">#8BB3BF</Color>
  <Color x:Key="TextColor">#0A1C24</Color>
  <Color x:Key="MutedColor">#3D6570</Color>
  <Color x:Key="AccentColor">#0097A8</Color>
  <Color x:Key="AccentHoverColor">#00B8C9</Color>
  <Color x:Key="GoldColor">#C47B00</Color>
  <Color x:Key="InkColor">#F4FBFC</Color>
  <Color x:Key="SelectColor">#B8EAF0</Color>
  <Color x:Key="HoverColor">#C5DCE3</Color>
  <Color x:Key="HeaderColor">#C5DCE3</Color>
  <Color x:Key="BrandBarColor">#D7E8EE</Color>
  <Color x:Key="TermBgColor">#071018</Color>
  <Color x:Key="TermFgColor">#7EE8C7</Color>
  <Color x:Key="ChromeBgColor">#F7FBFC</Color>
  <Color x:Key="ChromeFgColor">#0A1C24</Color>
  <Color x:Key="ChromeBorderColor">#0097A8</Color>
  <Color x:Key="OverlayColor">#CCE8F2F6</Color>
  <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="PanelAlt" Color="{StaticResource PanelAltColor}"/>
  <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
  <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldColor}"/>
  <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
  <SolidColorBrush x:Key="Select" Color="{StaticResource SelectColor}"/>
  <SolidColorBrush x:Key="Hover" Color="{StaticResource HoverColor}"/>
  <SolidColorBrush x:Key="Header" Color="{StaticResource HeaderColor}"/>
  <SolidColorBrush x:Key="BrandBar" Color="{StaticResource BrandBarColor}"/>
  <SolidColorBrush x:Key="BrandText" Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="BrandMuted" Color="{StaticResource MutedColor}"/>
  <SolidColorBrush x:Key="BrandAccent" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="TermBg" Color="{StaticResource TermBgColor}"/>
  <SolidColorBrush x:Key="TermFg" Color="{StaticResource TermFgColor}"/>
  <SolidColorBrush x:Key="ChromeBg" Color="{StaticResource ChromeBgColor}"/>
  <SolidColorBrush x:Key="ChromeFg" Color="{StaticResource ChromeFgColor}"/>
  <SolidColorBrush x:Key="ChromeBorder" Color="{StaticResource ChromeBorderColor}"/>
  <SolidColorBrush x:Key="Overlay" Color="{StaticResource OverlayColor}"/>
</ResourceDictionary>
