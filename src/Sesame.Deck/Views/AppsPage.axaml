<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sesame.Deck.Views.AppsPage">
  <Grid>
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="8,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Scan apps" Click="Scan_Click"/>
          <Button Classes="accent" Content="+ App" Click="Add_Click"/>
          <Button Content="Choose launch" Click="Pick_Click"/>
          <Button Content="Remove" Click="Remove_Click"/>
          <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Muted}"
                     Text="Native Deck apps. Duplicates are merged."/>
        </StackPanel>
      </Border>
      <ListBox x:Name="AppList">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="220,80,120,*,80,160" Margin="4,6">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="{Binding KindText}" Foreground="{DynamicResource Muted}"/>
              <TextBlock Grid.Column="2" Text="{Binding TagsText}" Foreground="{DynamicResource Muted}"/>
              <TextBlock Grid.Column="3" Text="{Binding Target}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"/>
              <TextBlock Grid.Column="4" Text="{Binding SteamText}"/>
              <TextBlock Grid.Column="5" Text="{Binding Status}" Foreground="{DynamicResource Muted}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <Border x:Name="BusyOverlay" Classes="overlay" IsVisible="False" ZIndex="20">
      <Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}"
              BorderThickness="1.5" CornerRadius="14" Padding="28,24">
        <StackPanel>
          <TextBlock FontSize="20" FontWeight="SemiBold" Text="Reading apps…"/>
          <TextBlock x:Name="BusyText" FontSize="14" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"
                     TextWrapping="Wrap" Text="This can take a moment while the Deck is busy."/>
          <ProgressBar Height="16" IsIndeterminate="True" Margin="0,18,0,0"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
