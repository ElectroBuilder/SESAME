<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sesame.Deck.Views.RemoteDialog"
        Title="SSH connection"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="#0B1218">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="Connect over SSH" FontSize="20" FontWeight="Bold"/>
    <TextBlock Text="Host"/>
    <TextBox x:Name="HostBox"/>
    <TextBlock Text="Port"/>
    <TextBox x:Name="PortBox" Text="22"/>
    <TextBlock Text="User"/>
    <TextBox x:Name="UserBox" Text="deck"/>
    <TextBlock Text="Private key"/>
    <DockPanel>
      <Button Content="Browse…" Click="Browse_Click" DockPanel.Dock="Right"/>
      <TextBox x:Name="KeyBox" Margin="0,0,8,0"/>
    </DockPanel>
    <TextBlock x:Name="ErrorText" Foreground="#FF6B7A" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Click="Cancel_Click"/>
      <Button Classes="accent" Content="Connect" Click="Connect_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
