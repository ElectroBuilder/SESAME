<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sesame.Deck.Views.ShellWindow"
        Title="SESAME"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="540"
        Background="#05070A"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Desktop -->
    <Grid x:Name="DesktopRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="#070B10" Padding="16,12" BorderBrush="#00D9F5" BorderThickness="0,0,0,2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <Image Source="avares://SESAME/Assets/sesame-icon-lg.png" Width="80" Height="80" Stretch="Uniform"/>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="SESAME" FontSize="28" FontWeight="Bold" Foreground="#00D9F5"/>
                <TextBlock x:Name="VersionLabel" FontSize="14" FontWeight="SemiBold"
                           Foreground="#FFB020" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
              </StackPanel>
              <TextBlock Text="STEAM DECK SHORTCUT &amp; ARTWORK MANAGER"
                         FontSize="12" FontWeight="SemiBold" Foreground="#FFB020"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="StatusLabel" Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0"
                     Foreground="#8EB8C4"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="LocalBtn" Classes="accent" Content="This Deck" Click="Local_Click"/>
            <Button x:Name="RemoteBtn" Content="SSH…" Click="Remote_Click"/>
            <Button Content="Disconnect" Click="Disconnect_Click"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#0B1218" BorderBrush="#1E4A58" BorderThickness="0,0,1,0" Padding="10">
          <StackPanel Spacing="8">
            <Button x:Name="NavOpt" Content="Optimize" HorizontalAlignment="Stretch" Click="NavOpt_Click"/>
            <Button x:Name="NavFiles" Content="Files" HorizontalAlignment="Stretch" Click="NavFiles_Click"/>
            <Button x:Name="NavSettings" Content="Settings" HorizontalAlignment="Stretch" Click="NavSettings_Click"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#8EB8C4" Margin="4,16,4,0"
                       Text="Local on the Deck or over SSH. Optimize from Game Mode is not possible: Steam has to close briefly."/>
          </StackPanel>
        </Border>
        <ContentControl x:Name="DesktopHost" Grid.Column="1"/>
      </Grid>
    </Grid>

    <!-- Game Mode -->
    <Grid x:Name="GameRoot" IsVisible="False">
      <Grid x:Name="GameHome">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="48,28,48,0" Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="20">
            <Image Source="avares://SESAME/Assets/sesame-icon-lg.png" Width="96" Height="96" Stretch="Uniform"/>
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="SESAME" FontSize="36" FontWeight="Bold" Foreground="#00D9F5"/>
              <TextBlock Text="STEAM DECK SHORTCUT &amp; ARTWORK MANAGER"
                         FontSize="16" FontWeight="SemiBold" Foreground="#FFB020"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="GameStatus" FontSize="18" Foreground="#8EB8C4"/>
        </StackPanel>
        <UniformGrid Grid.Row="1" Rows="2" Columns="2" Margin="48,16,48,24">
          <Button x:Name="Tile0" Classes="tile" Margin="10" Click="Tile0_Click">
            <StackPanel>
              <TextBlock Text="Optimize" FontSize="28" FontWeight="Bold"/>
              <TextBlock Text="Shortcuts, covers and tabs" Foreground="#8EB8C4" Margin="0,8,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="Tile1" Classes="tile" Margin="10" Click="Tile1_Click">
            <StackPanel>
              <TextBlock Text="Bibliotheek" FontSize="28" FontWeight="Bold"/>
              <TextBlock Text="Scanned ROMs and apps" Foreground="#8EB8C4" Margin="0,8,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="Tile2" Classes="tile" Margin="10" Click="Tile2_Click">
            <StackPanel>
              <TextBlock Text="Files" FontSize="28" FontWeight="Bold"/>
              <TextBlock Text="Folders on this Deck" Foreground="#8EB8C4" Margin="0,8,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="Tile3" Classes="tile" Margin="10" Click="Tile3_Click">
            <StackPanel>
              <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
              <TextBlock Text="SteamGridDB, local or SSH" Foreground="#8EB8C4" Margin="0,8,0,0"/>
            </StackPanel>
          </Button>
        </UniformGrid>
      </Grid>
      <Grid x:Name="GamePage" IsVisible="False">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#070B10" Padding="20,12" BorderBrush="#00D9F5" BorderThickness="0,0,0,2">
          <DockPanel>
            <Button Content="Back" Click="GameBack_Click" DockPanel.Dock="Left"/>
            <TextBlock x:Name="GamePageTitle" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0"/>
          </DockPanel>
        </Border>
        <ContentControl x:Name="GameHost" Grid.Row="1"/>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="#070B10" Padding="16,8" BorderBrush="#1E4A58" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock x:Name="HintBar" Foreground="#8EB8C4" FontSize="14"
                   Text="A confirm   B back   D-pad navigate   L/R tabs"/>
        <TextBlock x:Name="FooterStatus" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#00D9F5"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
