<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sesame.Deck.Views.StorePage">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="8,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,180,110,150,Auto">
        <TextBox x:Name="QueryBox" Watermark="Search packs" KeyDown="Query_KeyDown" Margin="0,0,8,0"/>
        <ComboBox x:Name="GameBox" Grid.Column="1" Margin="0,0,8,0"/>
        <ComboBox x:Name="KindBox" Grid.Column="2" Margin="0,0,8,0" SelectedIndex="0">
          <ComboBoxItem Content="All"/>
          <ComboBoxItem Content="Mods"/>
          <ComboBoxItem Content="ROM hacks"/>
          <ComboBoxItem Content="Texture packs"/>
        </ComboBox>
        <ComboBox x:Name="SourceBox" Grid.Column="3" Margin="0,0,8,0" SelectedIndex="0">
          <ComboBoxItem Content="All sources"/>
          <ComboBoxItem Content="GameBanana"/>
          <ComboBoxItem Content="Emulation King"/>
        </ComboBox>
        <Button Grid.Column="4" Classes="accent" Content="Search" Click="Search_Click"/>
      </Grid>
    </Border>
    <TextBlock x:Name="HintText" DockPanel.Dock="Bottom" Margin="12,6" Foreground="{DynamicResource Muted}"
               Text="Same store as Windows: pick a game identity, then search. Download from the result list."/>
    <ListBox x:Name="ResultList">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="4,8">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/>
            <TextBlock Foreground="{DynamicResource Muted}" Text="{Binding CardMeta}"/>
            <TextBlock Foreground="{DynamicResource Muted}" Text="{Binding Summary}" TextWrapping="Wrap" MaxHeight="48"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
