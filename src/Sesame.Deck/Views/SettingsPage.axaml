<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sesame.Deck.Views.SettingsPage">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="Settings" FontSize="26" FontWeight="Bold"/>

      <TextBlock Text="Library folders" FontWeight="SemiBold" Margin="0,12,0,0"/>
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                 Text="Set the ROM root and where Hydra, Lutris and other non-Steam games live. SESAME then creates empty system folders and Switch mods/saves for the emulators you use. No game titles are written."/>
      <TextBlock Text="ROMs" FontWeight="SemiBold"/>
      <TextBox x:Name="RomsRootBox" Watermark="/home/deck/Emulation/roms"/>
      <TextBlock Text="Hydra games" FontWeight="SemiBold"/>
      <TextBox x:Name="HydraRootBox" Watermark="/home/deck/Games/Hydra"/>
      <TextBlock Text="Lutris games" FontWeight="SemiBold"/>
      <TextBox x:Name="LutrisRootBox" Watermark="/home/deck/Games/Lutris"/>
      <TextBlock Text="Other non-Steam games" FontWeight="SemiBold"/>
      <TextBox x:Name="OtherGamesBox" Watermark="/home/deck/Games/Other"/>
      <TextBlock Text="Switch emulators" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                 Text="Mods and save folders are created only for the Switch emulators you check."/>
      <StackPanel Spacing="6">
        <CheckBox x:Name="UseEdenBox" Content="Eden"/>
        <CheckBox x:Name="UseYuzuBox" Content="Yuzu"/>
        <CheckBox x:Name="UseRyujinxBox" Content="Ryujinx"/>
        <CheckBox x:Name="UseCitronBox" Content="Citron"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="Save and create folders" Click="SaveLibrary_Click" HorizontalAlignment="Left"/>
      </StackPanel>
      <TextBlock x:Name="LibraryStatus" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/>

      <TextBlock Text="SteamGridDB API key" FontWeight="SemiBold" Margin="0,12,0,0"/>
      <TextBox x:Name="KeyBox" PasswordChar="•" Watermark="Paste your key"/>
      <Button Classes="accent" Content="Save" Click="SaveKey_Click" HorizontalAlignment="Left"/>
      <TextBlock x:Name="KeyStatus" Foreground="{DynamicResource Accent}"/>
      <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,12,0,0"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Dark" Click="Dark_Click"/>
        <Button Content="Light" Click="Light_Click"/>
      </StackPanel>

      <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,12,0,0"/>
      <TextBlock x:Name="UpdateVersion" TextWrapping="Wrap"/>
      <TextBlock x:Name="UpdateNotes" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Check for updates" Click="CheckUpdate_Click"/>
        <Button x:Name="InstallUpdateBtn" Classes="accent" Content="Install and restart"
                IsEnabled="False" Click="InstallUpdate_Click"/>
      </StackPanel>
      <TextBlock x:Name="UpdateStatus" Foreground="{DynamicResource Accent}" TextWrapping="Wrap"/>

      <Button Content="Switch to Desktop Mode (SteamOS)" Click="Desktop_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      <TextBlock FontSize="13" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                 Text="Optimize briefly closes Steam. Do that in Desktop Mode if SESAME is running from Game Mode."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
