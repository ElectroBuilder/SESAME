<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sesame.Deck.Views.SettingsPage">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="14" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Text="Settings" FontSize="26" FontWeight="Bold"/>
      <TextBlock TextWrapping="Wrap" Foreground="#8EB8C4"
                 Text="SESAME can manage this Steam Deck locally (no SSH) or over SSH from another machine."/>
      <TextBlock Text="SteamGridDB API key" FontWeight="SemiBold"/>
      <TextBox x:Name="KeyBox" PasswordChar="•" Watermark="Paste your key"/>
      <Button Classes="accent" Content="Save" Click="SaveKey_Click" HorizontalAlignment="Left"/>
      <TextBlock x:Name="KeyStatus" Foreground="#00D9F5"/>
      <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,12,0,0"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Dark" Click="Dark_Click"/>
        <Button Content="Light" Click="Light_Click"/>
      </StackPanel>
      <TextBlock Text="Session" FontWeight="SemiBold" Margin="0,12,0,0"/>
      <TextBlock x:Name="HostInfo" TextWrapping="Wrap"/>
      <Button Content="Switch to Desktop Mode (SteamOS)" Click="Desktop_Click" HorizontalAlignment="Left"/>
      <TextBlock FontSize="13" Foreground="#8EB8C4" TextWrapping="Wrap"
                 Text="Optimize briefly closes Steam. Do that in Desktop Mode if SESAME is running from Game Mode."/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
