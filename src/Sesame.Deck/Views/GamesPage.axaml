<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sesame.Deck.Views.GamesPage">
  <Grid>
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}" Padding="8,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Scan library" Click="Scan_Click"/>
            <Button Content="+ Game" Click="Add_Click"/>
          <Button Content="Open ROM folder" Click="OpenRom_Click"/>
          <Button Content="Open mods" Click="OpenMods_Click"/>
          <Button Content="Open saves" Click="OpenSaves_Click"/>
          <Button Content="Open texture packs" Click="OpenTextures_Click"/>
          <Button Classes="accent" Content="Search packs…" Click="SearchPacks_Click"/>
          <Button Content="Remove" Click="Remove_Click"/>
          <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Muted}"
                     Text="ROMs plus games you add yourself."/>
        </StackPanel>
      </Border>
      <ListBox x:Name="GameList">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="220,80,80,140,140,*" Margin="4,6">
              <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="{Binding System}" Foreground="{DynamicResource Muted}"/>
              <TextBlock Grid.Column="2" Text="{Binding KindText}"/>
              <TextBlock Grid.Column="3" Text="{Binding TagsText}" Foreground="{DynamicResource Muted}"/>
              <TextBlock Grid.Column="4" Text="{Binding TitleIdText}" Foreground="{DynamicResource Muted}"/>
              <TextBlock Grid.Column="5" Text="{Binding RomPath}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <Border x:Name="BusyOverlay" Classes="overlay" IsVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <ProgressBar IsIndeterminate="True" Width="280" Height="8"/>
        <TextBlock x:Name="BusyText" Text="Scanning games…" FontSize="18" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
