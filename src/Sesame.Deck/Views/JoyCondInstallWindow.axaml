<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sesame.Deck.Views.JoyCondInstallWindow"
        Title="Install Joy-Con motion (Dolphin)"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="View script" Click="ViewScript_Click"/>
      <Button Content="Refresh status" Click="Refresh_Click"/>
      <Button Classes="accent" Content="Install" Click="Install_Click"/>
      <Button Content="Close" Click="Close_Click"/>
    </StackPanel>
    <ScrollViewer>
      <StackPanel Spacing="8">
        <TextBlock Text="Dolphin · Joy-Con motion (joycond)" FontWeight="SemiBold" FontSize="16"/>
        <TextBlock x:Name="StatusLine" TextWrapping="Wrap"/>
        <TextBlock Text="Risks" FontWeight="SemiBold"/>
        <TextBlock x:Name="RiskBox" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
        <TextBlock Text="Sudo password" FontWeight="SemiBold"/>
        <TextBox x:Name="SudoBox" PasswordChar="•"/>
        <TextBlock Text="Not stored. Needed once for system install."
                   Foreground="{DynamicResource Muted}" FontSize="12"/>
        <CheckBox x:Name="RiskCheck"
                  Content="I understand the risks and want to install joycond for Dolphin"/>
        <TextBlock Text="Log" FontWeight="SemiBold"/>
        <TextBox x:Name="LogBox" Height="180" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" FontFamily="Consolas" FontSize="11"
                 Background="{DynamicResource PanelAlt}"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
