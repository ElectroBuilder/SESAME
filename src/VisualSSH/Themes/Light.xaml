<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#D5E4E6</Color>
    <Color x:Key="PanelColor">#E8F3F4</Color>
    <Color x:Key="PanelAltColor">#C5D8DC</Color>
    <Color x:Key="BorderColor">#8AADB4</Color>
    <Color x:Key="TextColor">#0B2A32</Color>
    <Color x:Key="MutedColor">#3D6570</Color>
    <Color x:Key="AccentColor">#1AAFA6</Color>
    <Color x:Key="AccentHoverColor">#148F88</Color>
    <Color x:Key="OkColor">#1B8A5A</Color>
    <Color x:Key="WarnColor">#C47B00</Color>
    <Color x:Key="DangerColor">#C0392B</Color>
    <Color x:Key="HeaderColor">#B7D0D4</Color>
    <Color x:Key="SelectColor">#9FE3DC</Color>
    <Color x:Key="TermBgColor">#0B2A32</Color>
    <Color x:Key="TermFgColor">#7EE8C7</Color>
    <Color x:Key="InkColor">#062018</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="PanelAlt" Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="Ok" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="Header" Color="{StaticResource HeaderColor}"/>
    <SolidColorBrush x:Key="Select" Color="{StaticResource SelectColor}"/>
    <SolidColorBrush x:Key="TermBg" Color="{StaticResource TermBgColor}"/>
    <SolidColorBrush x:Key="TermFg" Color="{StaticResource TermFgColor}"/>
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
</ResourceDictionary>
