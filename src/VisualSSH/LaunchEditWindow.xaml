<Window x:Class="VisualSSH.LaunchEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Startregels"
        Width="680" Height="420"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuleren" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Opslaan" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
        <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"
                       Text="Net als Steam ROM Manager: de hele startregel staat in Target. Startopties blijven leeg."/>
            <TextBlock Text="Target" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="TargetBox" Height="88" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="Zelfde veld als SRM Target, inclusief argumenten"/>
            <TextBlock Text="Start in" Foreground="{DynamicResource Muted}" Margin="0,10,0,4"/>
            <TextBox x:Name="StartDirBox" ToolTip="Werkmap van de shortcut, bijvoorbeeld /usr/bin"/>
            <TextBlock Text="Startopties" Foreground="{DynamicResource Muted}" Margin="0,10,0,4"/>
            <TextBox x:Name="OptionsBox" Height="52" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="Blijft leeg bij SRM-stijl. Extra argumenten worden aan Target geplakt."/>
            <CheckBox x:Name="LockBox" Margin="0,14,0,0"
                      Content="Deze game niet overschrijven bij optimaliseren"
                      ToolTip="Behoudt deze startregels, ook als het consolesjabloon anders is."/>
        </StackPanel>
    </DockPanel>
</Window>
