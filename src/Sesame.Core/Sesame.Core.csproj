<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sesame</RootNamespace>
    <AssemblyName>Sesame.Core</AssemblyName>
    <Product>SESAME</Product>
    <Description>Steam Easy Shortcut Artwork Manager Engine</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Sesame.Windows\AppBrand.cs" Link="AppBrand.cs" />
    <Compile Include="..\Sesame.Windows\AppVersion.cs" Link="AppVersion.cs" />
    <Compile Include="..\Sesame.Windows\Models\**\*.cs" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Sesame.Windows\Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\Sesame.Windows\Services\ThemeManager.cs;..\Sesame.Windows\Services\StoreImageCache.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Sesame.Windows\Data\catalog.json" LogicalName="Sesame.catalog.json" />
    <EmbeddedResource Include="..\Sesame.Windows\Scripts\extra-scan.py" LogicalName="Sesame.extra-scan.py" />
    <EmbeddedResource Include="..\Sesame.Windows\Scripts\sesame-dolphin.sh" LogicalName="Sesame.sesame-dolphin.sh" />
    <EmbeddedResource Include="..\Sesame.Windows\Scripts\sesame-dolphin-cfg.py" LogicalName="Sesame.sesame-dolphin-cfg.py" />
    <EmbeddedResource Include="..\Sesame.Windows\Assets\Logos\*.png" LogicalName="Sesame.Assets.Logos.%(Filename)%(Extension)" />
    <Content Include="..\Sesame.Windows\Assets\Logos\*.png" Link="Assets\Logos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="SharpCompress" Version="0.48.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
