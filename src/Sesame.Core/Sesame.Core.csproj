<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VisualSSH</RootNamespace>
    <AssemblyName>Sesame.Core</AssemblyName>
    <Product>SESAME</Product>
    <Description>Steam Easy Shortcut Artwork Manager Engine</Description>
    <Version>0.4.1</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\VisualSSH\AppBrand.cs" Link="AppBrand.cs" />
    <Compile Include="..\VisualSSH\AppVersion.cs" Link="AppVersion.cs" />
    <Compile Include="..\VisualSSH\Models\**\*.cs" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\VisualSSH\Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)"
             Exclude="..\VisualSSH\Services\ThemeManager.cs;..\VisualSSH\Services\StoreImageCache.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\VisualSSH\Assets\Logos\*.png" LogicalName="VisualSSH.Assets.Logos.%(Filename)%(Extension)" />
    <Content Include="..\VisualSSH\Data\catalog.json" Link="Data\catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\VisualSSH\Assets\Logos\*.png" Link="Assets\Logos\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="SharpCompress" Version="0.48.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
