<Window x:Class="Sesame.LaunchEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launch command"
        Icon="pack://application:,,,/Assets/sesame-taskbar.ico"
        Width="680" Height="420"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
        <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"
                       Text="Same as Steam ROM Manager: the full launch command lives in Target. Launch options stay empty."/>
            <TextBlock Text="Target" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="TargetBox" Height="88" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="Same field as SRM Target, including arguments"/>
            <TextBlock Text="Start in" Foreground="{DynamicResource Muted}" Margin="0,10,0,4"/>
            <TextBox x:Name="StartDirBox" ToolTip="Working directory of the shortcut, for example /usr/bin"/>
            <TextBlock Text="Launch options" Foreground="{DynamicResource Muted}" Margin="0,10,0,4"/>
            <TextBox x:Name="OptionsBox" Height="52" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="Stays empty in SRM style. Extra arguments are appended to Target."/>
            <CheckBox x:Name="LockBox" Margin="0,14,0,0"
                      Content="Do not overwrite this game when optimizing"
                      ToolTip="Keeps these launch rules even if the console template is different."/>
        </StackPanel>
    </DockPanel>
</Window>
