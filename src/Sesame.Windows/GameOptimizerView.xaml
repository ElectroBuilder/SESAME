<UserControl x:Class="Sesame.GameOptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="ArtThumb">
            <StackPanel Width="{Binding ThumbW}" Margin="4">
                <Border Width="{Binding ThumbW}" Height="{Binding ThumbH}"
                        Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                    <Image Source="{Binding Preview}" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource Muted}"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Bg}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="Scan" Click="Scan_Click"
                        ToolTip="Read ROMs, Hydra games and apps on the Deck"/>
                <Button Content="Optimize" Style="{StaticResource AccentButton}"
                        Click="OptimizeSelected_Click"
                        ToolTip="Write shortcuts, artwork, category and FPS for Steam Game Mode"/>
                <Button Content="Choose launch" Click="PickLaunch_Click"
                        ToolTip="When the same app was found more than once, pick the launch to keep."/>
                <ComboBox x:Name="SystemFilter" Width="180" Margin="8,0,8,0"
                          SelectionChanged="Filter_Changed"/>
                <TextBox x:Name="SearchBox" Width="220" KeyDown="Search_KeyDown"
                         ToolTip="Filter by name"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="HintText" DockPanel.Dock="Bottom" Margin="10,4,10,6"
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                   Text="Connect, then Scan. SESAME writes its own shortcuts only; Hydra and Steam ROM Manager stay."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="760"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="GameList" Grid.Column="0" BorderThickness="0"
                      SelectionChanged="Game_Changed"
                      SelectionMode="Extended">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="36">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="48">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Cover}" Width="36" Height="54" Stretch="Uniform"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Name" Width="200"
                                        DisplayMemberBinding="{Binding DisplayName}"/>
                        <GridViewColumn Header="System" Width="120"
                                        DisplayMemberBinding="{Binding SystemName}"/>
                        <GridViewColumn Header="Emulator" Width="130"
                                        DisplayMemberBinding="{Binding EmulatorName}"/>
                        <GridViewColumn Header="Kind" Width="70"
                                        DisplayMemberBinding="{Binding KindText}"/>
                        <GridViewColumn Header="Tags" Width="140"
                                        DisplayMemberBinding="{Binding TagsText}"/>
                        <GridViewColumn Header="Category" Width="140"
                                        DisplayMemberBinding="{Binding Category}"/>
                        <GridViewColumn Header="FPS" Width="70"
                                        DisplayMemberBinding="{Binding FpsText}"/>
                        <GridViewColumn Header="Steam" Width="70"
                                        DisplayMemberBinding="{Binding SteamText}"/>
                        <GridViewColumn Header="Artwork" Width="100"
                                        DisplayMemberBinding="{Binding ArtworkText}"/>
                        <GridViewColumn Header="Status" Width="120"
                                        DisplayMemberBinding="{Binding Status}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource Bg}"/>

            <Grid Grid.Column="2" Background="{DynamicResource Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="10,10,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="3.1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2.14*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="128"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="74"/>
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="3" CornerRadius="6"
                            Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="COVER" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="CoverImage" Stretch="Uniform"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" CornerRadius="6"
                            Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="HERO" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="HeroImage" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="4" CornerRadius="6"
                            Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}"
                            BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="WIDE" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="WideImage" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="2" Grid.ColumnSpan="3" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="6"
                                Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="ICON" FontSize="8" Foreground="{DynamicResource Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="IconImage" Stretch="Uniform"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="6"
                                Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="LOGO" FontSize="9" Foreground="{DynamicResource Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="LogoImage" Stretch="Uniform"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="1" Margin="10,0,10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Display name" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                        <TextBlock Grid.Column="2" Text="SteamGridDB search name"
                                   Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" Grid.Row="1" LostFocus="Name_LostFocus"
                                 ToolTip="Display name in Steam"/>
                        <TextBox x:Name="QueryBox" Grid.Row="1" Grid.Column="2" LostFocus="Name_LostFocus"
                                 ToolTip="Change the search name if the wrong game is found"/>
                        <Button Grid.Row="1" Grid.Column="3" Content="Search" Click="SearchArt_Click" Margin="8,0,0,0"/>
                        <CheckBox x:Name="MaskBox" Grid.Row="1" Grid.Column="4" Content="Category masks"
                                  Margin="8,0,0,0" Checked="Mask_Changed" Unchecked="Mask_Changed"
                                  ToolTip="Master switch. Per platform you set masks in Settings → Covers. Hydra is off by default."/>
                    </Grid>
                    <TextBlock x:Name="MetaText" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="NoteText" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <TabControl x:Name="ArtTabs" Grid.Row="2" Margin="10,0,10,6">
                    <TabItem Header="Cover">
                        <ListBox x:Name="CoverList" BorderThickness="0" Background="{DynamicResource PanelAlt}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource ArtThumb}"
                                 SizeChanged="ArtPanel_SizeChanged"
                                 SelectionChanged="Art_Changed">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Wide">
                        <ListBox x:Name="WideList" BorderThickness="0" Background="{DynamicResource PanelAlt}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource ArtThumb}"
                                 SizeChanged="ArtPanel_SizeChanged"
                                 SelectionChanged="Art_Changed">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Hero">
                        <ListBox x:Name="HeroList" BorderThickness="0" Background="{DynamicResource PanelAlt}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource ArtThumb}"
                                 SizeChanged="ArtPanel_SizeChanged"
                                 SelectionChanged="Art_Changed">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Logo">
                        <ListBox x:Name="LogoList" BorderThickness="0" Background="{DynamicResource PanelAlt}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource ArtThumb}"
                                 SizeChanged="ArtPanel_SizeChanged"
                                 SelectionChanged="Art_Changed">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Icon">
                        <ListBox x:Name="IconList" BorderThickness="0" Background="{DynamicResource PanelAlt}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemTemplate="{StaticResource ArtThumb}"
                                 SizeChanged="ArtPanel_SizeChanged"
                                 SelectionChanged="Art_Changed">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Sets">
                        <ListBox x:Name="SetList" BorderThickness="0"
                                 Background="{DynamicResource PanelAlt}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="Set_Changed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="2" Background="{DynamicResource Panel}" CornerRadius="6"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Use set"
                                                    VerticalAlignment="Center" Click="UseSet_Click"
                                                    Tag="{Binding}" Margin="8,0,0,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                           Foreground="{DynamicResource Muted}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border Width="36" Height="54" Margin="0,0,6,0"
                                                            Background="{DynamicResource PanelAlt}" ClipToBounds="True">
                                                        <Image Source="{Binding Cover.Preview}" Stretch="Uniform"/>
                                                    </Border>
                                                    <Border Width="72" Height="34" Margin="0,0,6,0"
                                                            Background="{DynamicResource PanelAlt}" ClipToBounds="True">
                                                        <Image Source="{Binding Wide.Preview}" Stretch="Uniform"/>
                                                    </Border>
                                                    <Border Width="88" Height="28" Margin="0,0,6,0"
                                                            Background="{DynamicResource PanelAlt}" ClipToBounds="True">
                                                        <Image Source="{Binding Hero.Preview}" Stretch="Uniform"/>
                                                    </Border>
                                                    <Border Width="28" Height="28" Margin="0,0,6,0"
                                                            Background="{DynamicResource PanelAlt}" ClipToBounds="True">
                                                        <Image Source="{Binding Icon.Preview}" Stretch="Uniform"/>
                                                    </Border>
                                                    <Border Width="72" Height="28"
                                                            Background="{DynamicResource PanelAlt}" ClipToBounds="True">
                                                        <Image Source="{Binding Logo.Preview}" Stretch="Uniform"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>

        <Grid x:Name="ProgressOverlay" Visibility="Collapsed" Panel.ZIndex="20">
            <Border Background="{DynamicResource Bg}" Opacity="0.88"/>
            <Border Width="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1.5" CornerRadius="14" Padding="32,28">
                <StackPanel>
                    <TextBlock x:Name="OverlayTitle" FontSize="22" FontWeight="SemiBold"
                               TextWrapping="Wrap" Text="Working…"/>
                    <TextBlock x:Name="OverlayDetail" FontSize="14" Foreground="{DynamicResource Muted}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OverlayCount" FontSize="14" FontWeight="SemiBold"
                               Margin="0,16,0,0"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="OverlayBar" Height="18" Minimum="0" Maximum="100"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="OverlayPercent" Grid.Column="1" Margin="14,0,0,0"
                                   FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center" Text="0%"/>
                    </Grid>
                    <TextBlock x:Name="OverlayEta" FontSize="13" Foreground="{DynamicResource Muted}"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
