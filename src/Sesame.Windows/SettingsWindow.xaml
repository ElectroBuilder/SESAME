<Window x:Class="Sesame.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sesame"
        Title="Settings — SESAME"
        Icon="pack://application:,,,/Assets/sesame-taskbar.ico"
        Height="760" Width="980"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Style="{StaticResource AccentButton}" IsDefault="True"
                    Click="Close_Click" Margin="0"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock Text="Theme" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <RadioButton x:Name="DarkThemeBox" Content="Dark" GroupName="Theme"
                                         Checked="Theme_Changed"/>
                            <RadioButton x:Name="LightThemeBox" Content="Light" GroupName="Theme"
                                         Checked="Theme_Changed"/>
                        </StackPanel>

                        <TextBlock Text="Steam tabs" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                                   Text="How SESAME groups optimized ROMs in Steam. Hydra games and native apps (Kodi, Stremio, …) get their own tabs (Hydra / Apps). Old SESAME tabs are removed on the next optimize; Hydra, Steam ROM Manager and manual collections stay."/>
                        <RadioButton x:Name="TabsPlatformBox" GroupName="SteamTabs" Margin="0,0,0,6"
                                     Checked="SteamTabs_Changed">
                            <TextBlock TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="By platform"/>
                                <Run Text=" — one tab per system (NES, SNES, PSX, PS2, …), including new folders."/>
                            </TextBlock>
                        </RadioButton>
                        <RadioButton x:Name="TabsBrandBox" GroupName="SteamTabs" Margin="0,0,0,6"
                                     Checked="SteamTabs_Changed">
                            <TextBlock TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="By brand"/>
                                <Run Text=" — Nintendo, PlayStation, Sega, Arcade, Xbox. Unknown systems go to their brand or their own tab."/>
                            </TextBlock>
                        </RadioButton>
                        <RadioButton x:Name="TabsEmulationBox" GroupName="SteamTabs" Margin="0,0,0,24"
                                     Checked="SteamTabs_Changed">
                            <TextBlock TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="One tab: Emulation"/>
                                <Run Text=" — all emulated games in one Steam collection."/>
                            </TextBlock>
                        </RadioButton>

                        <TextBlock Text="SteamGridDB" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                                   Text="The API key is stored encrypted for this Windows account and is never shown on screen."/>
                        <TextBlock Text="API key" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Remove" Click="ClearKey_Click"
                                    Margin="8,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource AccentButton}"
                                    Click="SaveKey_Click"/>
                            <PasswordBox x:Name="KeyBox"
                                         ToolTip="Paste a new key to replace the stored secret"/>
                        </DockPanel>
                        <TextBlock Foreground="{DynamicResource Accent}">
                            <Hyperlink NavigateUri="https://www.steamgriddb.com/profile/preferences/api"
                                       RequestNavigate="OpenLink" Foreground="{DynamicResource Accent}">Create a key</Hyperlink>
                        </TextBlock>
                        <TextBlock x:Name="KeyStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Covers">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel>
                        <TextBlock Text="Category masks" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"
                                   Text="A colored bar with a console logo on top of the cover. Turn this on or off per platform. Hydra is off by default: those games often already have artwork. Apps (Kodi, Stremio, …) are also off by default. The Artwork mask switch is the master: if it is off, nothing gets a mask."/>
                        <CheckBox x:Name="MasksMasterBox" Content="Use category masks"
                                  Margin="0,0,0,14" Checked="MasksMaster_Changed" Unchecked="MasksMaster_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Defaults" Click="MasksDefault_Click"
                                    ToolTip="ROMs on, Hydra and Apps off"/>
                            <Button Content="All on" Click="MasksAllOn_Click"/>
                            <Button Content="All off" Click="MasksAllOff_Click"/>
                        </StackPanel>
                        <ItemsControl x:Name="MaskList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              Width="170" Margin="0,0,12,10"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Data">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="What SESAME stores" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"
                                   Text="Everything lives in %APPDATA%\SESAME, readable only for this Windows account. SSH keys, passwords, SteamGridDB and DeepL keys use Windows DPAPI (encrypted per user) and never go in JSON. The library cache is per Steam Deck profile: if you switch Deck, SESAME scans that Deck live (ROMs, Hydra, apps) and does not show the previous list."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="• secrets\ — SSH, API keys (DPAPI, hidden)"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="• optimizer-cache\ — game list per Deck, without artwork files"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="• art-cache / store-cache — downloaded covers and store thumbnails"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="• optimizer-picks.json — your cover choices (not secrets)"/>
                        <Button Content="Clear artwork and search cache" Click="ClearCaches_Click"
                                HorizontalAlignment="Left"
                                ToolTip="Removes art-cache, store-cache and optimizer-cache. Keys and cover picks stay."/>
                        <TextBlock x:Name="CacheStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Library">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Library folders" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"
                                   Text="ROM, Hydra and other game roots on the Steam Deck. After you save, SESAME creates the empty system folders, Hydra/Lutris/Other dirs, and Switch mods/saves for the emulators you use. No game list is shipped or written."/>
                        <TextBlock Text="ROMs" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                        <TextBox x:Name="RomsRootBox" Margin="0,0,0,12"/>
                        <TextBlock Text="Hydra games" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                        <TextBox x:Name="HydraRootBox" Margin="0,0,0,12"/>
                        <TextBlock Text="Lutris games" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                        <TextBox x:Name="LutrisRootBox" Margin="0,0,0,12"/>
                        <TextBlock Text="Other non-Steam games" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                        <TextBox x:Name="OtherGamesBox" Margin="0,0,0,16"/>
                        <TextBlock Text="Switch emulators" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                                   Text="SESAME creates mods and save folders only for the Switch emulators you use (Eden, Yuzu, Ryujinx, Citron)."/>
                        <CheckBox x:Name="UseEdenBox" Content="Eden" Margin="0,0,0,6"/>
                        <CheckBox x:Name="UseYuzuBox" Content="Yuzu" Margin="0,0,0,6"/>
                        <CheckBox x:Name="UseRyujinxBox" Content="Ryujinx" Margin="0,0,0,6"/>
                        <CheckBox x:Name="UseCitronBox" Content="Citron" Margin="0,0,0,16"/>
                        <Button Content="Save library paths" Style="{StaticResource AccentButton}"
                                Click="SaveLibrary_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="LibraryStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Emulators">
                <local:LaunchersView x:Name="Launchers" Margin="4,12,4,0"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
