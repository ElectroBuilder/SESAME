<Window x:Class="Sesame.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sesame"
        Title="Instellingen — SESAME"
        Icon="pack://application:,,,/Assets/sesame-taskbar.ico"
        Height="760" Width="980"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Sluiten" Style="{StaticResource AccentButton}" IsDefault="True"
                    Click="Close_Click" Margin="0"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Algemeen">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Uiterlijk" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock Text="Thema" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <RadioButton x:Name="DarkThemeBox" Content="Donker" GroupName="Theme"
                                         Checked="Theme_Changed"/>
                            <RadioButton x:Name="LightThemeBox" Content="Licht" GroupName="Theme"
                                         Checked="Theme_Changed"/>
                        </StackPanel>

                        <TextBlock Text="Steam-tabladen" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                                   Text="Zo groepeert SESAME geoptimaliseerde ROMs in Steam. Hydra-games en native apps (Kodi, Stremio, …) komen in eigen tabladen (Hydra / Apps). Oude SESAME-tabladen verdwijnen bij de volgende optimalisatie; shortcuts van Hydra, Steam ROM Manager en handmatige collecties blijven staan."/>
                        <RadioButton x:Name="TabsPlatformBox" GroupName="SteamTabs" Margin="0,0,0,6"
                                     Checked="SteamTabs_Changed">
                            <TextBlock TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Per platform"/>
                                <Run Text=" — een tablad per systeem (NES, SNES, PSX, PS2, …), ook voor nieuwe mappen."/>
                            </TextBlock>
                        </RadioButton>
                        <RadioButton x:Name="TabsBrandBox" GroupName="SteamTabs" Margin="0,0,0,6"
                                     Checked="SteamTabs_Changed">
                            <TextBlock TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Per merk"/>
                                <Run Text=" — Nintendo, PlayStation, Sega, Arcade, Xbox. Onbekende systemen gaan naar hun merk of een eigen tablad."/>
                            </TextBlock>
                        </RadioButton>
                        <RadioButton x:Name="TabsEmulationBox" GroupName="SteamTabs" Margin="0,0,0,24"
                                     Checked="SteamTabs_Changed">
                            <TextBlock TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Eén tablad: Emulation"/>
                                <Run Text=" — alle geëmuleerde games in één Steam-collectie."/>
                            </TextBlock>
                        </RadioButton>

                        <TextBlock Text="SteamGridDB" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"
                                   Text="De API-sleutel wordt versleuteld opgeslagen voor dit Windows-account en nooit in beeld getoond."/>
                        <TextBlock Text="API-sleutel" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Verwijderen" Click="ClearKey_Click"
                                    Margin="8,0,0,0"/>
                            <Button DockPanel.Dock="Right" Content="Opslaan" Style="{StaticResource AccentButton}"
                                    Click="SaveKey_Click"/>
                            <PasswordBox x:Name="KeyBox"
                                         ToolTip="Nieuwe sleutel plakken om de opgeslagen secret te vervangen"/>
                        </DockPanel>
                        <TextBlock Foreground="{DynamicResource Accent}">
                            <Hyperlink NavigateUri="https://www.steamgriddb.com/profile/preferences/api"
                                       RequestNavigate="OpenLink" Foreground="{DynamicResource Accent}">Sleutel aanmaken</Hyperlink>
                        </TextBlock>
                        <TextBlock x:Name="KeyStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Covers">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel>
                        <TextBlock Text="Categoriemaskers" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"
                                   Text="Een gekleurde balk met console-logo bovenop de cover. Zet dit per platform aan of uit. Hydra staat standaard uit: die games hebben vaak al eigen artwork. Apps (Kodi, Stremio, …) ook standaard uit. De schakelaar in de Game Optimizer is de master: als die uit staat, krijgt niets een masker."/>
                        <CheckBox x:Name="MasksMasterBox" Content="Categoriemaskers gebruiken"
                                  Margin="0,0,0,14" Checked="MasksMaster_Changed" Unchecked="MasksMaster_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Standaard" Click="MasksDefault_Click"
                                    ToolTip="ROMs aan, Hydra en Apps uit"/>
                            <Button Content="Alles aan" Click="MasksAllOn_Click"/>
                            <Button Content="Alles uit" Click="MasksAllOff_Click"/>
                        </StackPanel>
                        <ItemsControl x:Name="MaskList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              Width="170" Margin="0,0,12,10"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Gegevens">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,4,4">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Wat SESAME bewaart" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"
                                   Text="Alles staat in %APPDATA%\SESAME, alleen leesbaar voor dit Windows-account. SSH-sleutels, wachtwoorden, SteamGridDB- en DeepL-sleutels gaan via Windows DPAPI (versleuteld per gebruiker) en staan nooit in JSON. De bibliotheekcache is per Steam Deck-profiel: wissel je van Deck, dan scant SESAME die Deck live (ROMs, Hydra, apps) en toont niet de lijst van de vorige."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="• secrets\ — SSH, API-sleutels (DPAPI, verborgen)"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="• optimizer-cache\ — spelerslijst per Deck, zonder artwork-bestanden"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="• art-cache / store-cache — gedownloade covers en winkelminiaturen"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="• optimizer-picks.json — jouw coverkeuzes (geen geheimen)"/>
                        <Button Content="Artwork- en zoekcache wissen" Click="ClearCaches_Click"
                                HorizontalAlignment="Left"
                                ToolTip="Verwijdert art-cache, store-cache en optimizer-cache. Sleutels en coverkeuzes blijven."/>
                        <TextBlock x:Name="CacheStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Emulators">
                <local:LaunchersView x:Name="Launchers" Margin="4,12,4,0"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
