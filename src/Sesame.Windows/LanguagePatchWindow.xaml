<Window x:Class="Sesame.LanguagePatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nederlandse taalpatch"
        Icon="pack://application:,,,/Assets/sesame-taskbar.ico"
        Height="800" Width="1220"
        MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="14,10"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Vertical" VerticalAlignment="Top" Margin="12,0,0,0">
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Excel exporteren" Click="Export_Click"
                                ToolTip="Slaat de tabel op als .xlsx of .csv. Aanpassen in Excel en daarna importeren."/>
                        <Button Content="Excel importeren" Click="Import_Click"
                                ToolTip="Leest Nederlands uit Excel/CSV en maakt dat de nieuwe vertaling."/>
                        <Button Content="Cache wissen" Click="ClearCache_Click" x:Name="ClearCacheBtn"
                                ToolTip="Verwijdert opgeslagen automatische vertalingen. Teksten in dit scherm blijven staan."/>
                    </WrapPanel>
                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Online vertalen" Click="OnlineTranslate_Click" x:Name="OnlineBtn"
                                ToolTip="Vraagt vertaalservers. Alleen nodig als de cache leeg is of je opnieuw online wilt. Start niet vanzelf als er al een cache is."/>
                        <Button Content="Rest lokaal afmaken" Click="Retranslate_Click" x:Name="RetranslateBtn"
                                ToolTip="Vult ontbrekende regels in de app zelf aan, zonder internet. Jouw handmatige edits blijven staan."/>
                        <Button Content="Annuleren" IsCancel="True" Click="Cancel_Click"/>
                        <Button Content="ROM maken" Style="{StaticResource AccentButton}"
                                x:Name="ApplyBtn" Click="Apply_Click" IsEnabled="False"
                                ToolTip="Bouwt een nieuwe .z64 met de Nederlandse teksten. Het origineel blijft staan."/>
                        <Button Content="Naar Deck" Style="{StaticResource AccentButton}"
                                x:Name="DeckBtn" Click="Deck_Click" Visibility="Collapsed"
                                ToolTip="Sluit dit scherm en zet de gemaakte ROM op de Deck."/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" Margin="0,2,0,8"
                               Text="ROM lezen…" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="WorkBar" Minimum="0" Maximum="100" Value="0"/>
                      <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="CountText" Foreground="{DynamicResource Text}" FontWeight="SemiBold"
                                   Text="0 vertaald · 0 te gaan · 0 totaal"/>
                        <TextBlock x:Name="CacheText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Muted}" Text=""/>
                      </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource Muted}" Text="DeepL-sleutel"/>
                        <Button DockPanel.Dock="Right" Content="Wissen" Click="ClearDeepL_Click"
                                Margin="8,0,0,0"
                                ToolTip="Verwijdert de opgeslagen DeepL-sleutel."/>
                        <Button DockPanel.Dock="Right" Content="Opslaan" Click="SaveDeepL_Click"
                                Margin="8,0,0,0"
                                ToolTip="Slaat de sleutel versleuteld op voor dit Windows-account. Zonder sleutel gebruikt SESAME Google."/>
                        <PasswordBox x:Name="DeepLKeyBox"
                                     ToolTip="Typ alleen een nieuwe sleutel om de opgeslagen secret te vervangen."/>
                    </DockPanel>
                    <TextBlock x:Name="DeepLStatus" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"
                               Text="Geen DeepL-sleutel: Google als fallback."/>
                    <TextBlock x:Name="ErrorText" Foreground="#B42318" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="SuccessText" Foreground="#067647" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" Padding="12,8"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="HintText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                       Text="Zet optioneel een DeepL-sleutel bovenaan. ROM maken zet Nederlandse tekst in een nieuwe dump; als die niet in het originele gat past, wordt extra ROM-ruimte gebruikt. Het origineel blijft staan."/>
        </Border>

        <TabControl Margin="10">
            <TabItem Header="Teksten">
                <DockPanel Margin="0,8,0,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilterBox" Grid.Column="0" Margin="0,0,8,0"
                                 Tag="Zoeken in Engels of Nederlands…"
                                 TextChanged="Filter_Changed"/>
                        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource Muted}"
                                   Text="{Binding Tag, ElementName=FilterBox}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox x:Name="KindBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Alle teksten"/>
                            <ComboBoxItem Content="Alleen dialoog"/>
                            <ComboBoxItem Content="Alleen quiz"/>
                            <ComboBoxItem Content="Alleen ROM-tekst"/>
                            <ComboBoxItem Content="Gewijzigd"/>
                        </ComboBox>
                    </Grid>
                    <DataGrid x:Name="LineGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="{DynamicResource Panel}"
                              Foreground="{DynamicResource Text}"
                              BorderBrush="{DynamicResource Border}"
                              RowBackground="{DynamicResource Panel}"
                              AlternatingRowBackground="{DynamicResource PanelAlt}"
                              HorizontalGridLinesBrush="{DynamicResource Border}"
                              EnableRowVirtualization="True"
                              SelectionUnit="Cell"
                              CellEditEnding="LineGrid_CellEditEnding"
                              LostKeyboardFocus="LineGrid_LostKeyboardFocus">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Soort" Binding="{Binding KindText}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Spreker" Binding="{Binding Speaker}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Engels" Binding="{Binding Original}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Nederlands" Width="*">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Translation" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tekens" Binding="{Binding LengthText}" Width="70" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Gezegdes en vaste zinnen">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource Muted}"
                               Text="Spreekwoorden en leuzen in deze ROM. Die worden als Nederlands equivalent gezet (kick your butt → ik maak je in), niet woord-voor-woord. Vaste zinnen en woordgroepen komen vaak terug en blijven in context vertaald."/>
                    <DataGrid x:Name="PhraseGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="{DynamicResource Panel}"
                              Foreground="{DynamicResource Text}"
                              BorderBrush="{DynamicResource Border}"
                              RowBackground="{DynamicResource Panel}"
                              AlternatingRowBackground="{DynamicResource PanelAlt}"
                              HorizontalGridLinesBrush="{DynamicResource Border}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Soort" Binding="{Binding Kind}" Width="110"/>
                            <DataGridTextColumn Header="Engels" Binding="{Binding English}" Width="*"/>
                            <DataGridTextColumn Header="Nederlands equivalent" Binding="{Binding Dutch}" Width="*"/>
                            <DataGridTextColumn Header="Keer" Binding="{Binding Count}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
