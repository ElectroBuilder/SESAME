<Window x:Class="Sesame.LanguagePatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dutch language patch"
        Icon="pack://application:,,,/Assets/sesame-taskbar.ico"
        Height="800" Width="1220"
        MinHeight="560" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" Padding="14,10"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Vertical" VerticalAlignment="Top" Margin="12,0,0,0">
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Export Excel" Click="Export_Click"
                                ToolTip="Saves the table as .xlsx or .csv. Edit in Excel, then import."/>
                        <Button Content="Import Excel" Click="Import_Click"
                                ToolTip="Reads Dutch from Excel/CSV and makes that the new translation."/>
                        <Button Content="Clear cache" Click="ClearCache_Click" x:Name="ClearCacheBtn"
                                ToolTip="Removes stored automatic translations. Text on this screen stays."/>
                    </WrapPanel>
                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Translate online" Click="OnlineTranslate_Click" x:Name="OnlineBtn"
                                ToolTip="Calls translation servers. Only needed if the cache is empty or you want to run online again. Does not start by itself when a cache already exists."/>
                        <Button Content="Finish remaining locally" Click="Retranslate_Click" x:Name="RetranslateBtn"
                                ToolTip="Fills missing rows in the app itself, offline. Your manual edits stay."/>
                        <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
                        <Button Content="Build ROM" Style="{StaticResource AccentButton}"
                                x:Name="ApplyBtn" Click="Apply_Click" IsEnabled="False"
                                ToolTip="Builds a new .z64 with the Dutch texts. The original file stays."/>
                        <Button Content="To Deck" Style="{StaticResource AccentButton}"
                                x:Name="DeckBtn" Click="Deck_Click" Visibility="Collapsed"
                                ToolTip="Closes this window and puts the built ROM on the Deck."/>
                    </WrapPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" Margin="0,2,0,8"
                               Text="Reading ROM…" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="WorkBar" Minimum="0" Maximum="100" Value="0"/>
                      <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="CountText" Foreground="{DynamicResource Text}" FontWeight="SemiBold"
                                   Text="0 translated · 0 remaining · 0 total"/>
                        <TextBlock x:Name="CacheText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Muted}" Text=""/>
                      </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource Muted}" Text="DeepL key"/>
                        <Button DockPanel.Dock="Right" Content="Clear" Click="ClearDeepL_Click"
                                Margin="8,0,0,0"
                                ToolTip="Removes the stored DeepL key."/>
                        <Button DockPanel.Dock="Right" Content="Save" Click="SaveDeepL_Click"
                                Margin="8,0,0,0"
                                ToolTip="Stores the key encrypted for this Windows account. Without a key SESAME uses Google."/>
                        <PasswordBox x:Name="DeepLKeyBox"
                                     ToolTip="Type a new key only to replace the stored secret."/>
                    </DockPanel>
                    <TextBlock x:Name="DeepLStatus" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"
                               Text="No DeepL key: Google as fallback."/>
                    <TextBlock x:Name="ErrorText" Foreground="#B42318" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="SuccessText" Foreground="#067647" Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" Padding="12,8"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="HintText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                       Text="Optionally set a DeepL key at the top. Build ROM writes Dutch text into a new dump; if it does not fit the original slot, extra ROM space is used. The original file stays."/>
        </Border>

        <TabControl Margin="10">
            <TabItem Header="Texts">
                <DockPanel Margin="0,8,0,0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilterBox" Grid.Column="0" Margin="0,0,8,0"
                                 Tag="Search in English or Dutch…"
                                 TextChanged="Filter_Changed"/>
                        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource Muted}"
                                   Text="{Binding Tag, ElementName=FilterBox}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox x:Name="KindBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All texts"/>
                            <ComboBoxItem Content="Dialogue only"/>
                            <ComboBoxItem Content="Quiz only"/>
                            <ComboBoxItem Content="ROM text only"/>
                            <ComboBoxItem Content="Changed"/>
                        </ComboBox>
                    </Grid>
                    <DataGrid x:Name="LineGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="{DynamicResource Panel}"
                              Foreground="{DynamicResource Text}"
                              BorderBrush="{DynamicResource Border}"
                              RowBackground="{DynamicResource Panel}"
                              AlternatingRowBackground="{DynamicResource PanelAlt}"
                              HorizontalGridLinesBrush="{DynamicResource Border}"
                              EnableRowVirtualization="True"
                              SelectionUnit="Cell"
                              CellEditEnding="LineGrid_CellEditEnding"
                              LostKeyboardFocus="LineGrid_LostKeyboardFocus">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Kind" Binding="{Binding KindText}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Speaker" Binding="{Binding Speaker}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="English" Binding="{Binding Original}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Dutch" Width="*">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Translation" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Chars" Binding="{Binding LengthText}" Width="70" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Idioms and set phrases">
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource Muted}"
                               Text="Proverbs and slogans in this ROM. Those are mapped to a Dutch equivalent (kick your butt → ik maak je in), not word-for-word. Set phrases and word groups often repeat and stay translated in context."/>
                    <DataGrid x:Name="PhraseGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="{DynamicResource Panel}"
                              Foreground="{DynamicResource Text}"
                              BorderBrush="{DynamicResource Border}"
                              RowBackground="{DynamicResource Panel}"
                              AlternatingRowBackground="{DynamicResource PanelAlt}"
                              HorizontalGridLinesBrush="{DynamicResource Border}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110"/>
                            <DataGridTextColumn Header="English" Binding="{Binding English}" Width="*"/>
                            <DataGridTextColumn Header="Dutch equivalent" Binding="{Binding Dutch}" Width="*"/>
                            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
