<UserControl x:Class="Sesame.MiiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{DynamicResource Bg}" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="TargetBox" Width="220" SelectionChanged="TargetBox_SelectionChanged">
                <ComboBoxItem Tag="Wii">Dolphin · Wii Mii database</ComboBoxItem>
                <ComboBoxItem Tag="Eden">Eden · Switch Mii database</ComboBoxItem>
            </ComboBox>
            <Button x:Name="RefreshBtn" Content="Refresh" Click="Refresh_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,10">
            <StackPanel>
                <TextBlock x:Name="CapabilityText" FontWeight="SemiBold"/>
                <TextBlock x:Name="IntegrityText" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="PathText" Margin="0,4,0,0" Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap"/>
                <ComboBox x:Name="DatabasePathBox" Margin="0,7,0,0" DisplayMemberPath="Path"
                          SelectionChanged="DatabasePathBox_SelectionChanged" Visibility="Collapsed"
                          ToolTip="Choose the emulator database SESAME may read and, after opt-in, replace."/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Mii maker" FontWeight="SemiBold"/>
                <TextBlock Text="Select a Mii to edit it, or enter a name and choose Create Mii. Changes stay safely in a draft until you save."
                           Foreground="{DynamicResource Muted}" Margin="0,3,0,8" TextWrapping="Wrap"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="Name" Foreground="{DynamicResource Muted}"/>
                        <TextBox x:Name="NameBox" Width="150" MaxLength="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="Gender" Foreground="{DynamicResource Muted}"/>
                        <ComboBox x:Name="GenderBox" Width="105" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Male" Tag="False"/>
                            <ComboBoxItem Content="Female" Tag="True"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="Hair style" Foreground="{DynamicResource Muted}"/>
                        <ComboBox x:Name="HairStyleBox" Width="105"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="Hair colour" Foreground="{DynamicResource Muted}"/>
                        <ComboBox x:Name="HairColorBox" Width="110"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="Eye colour" Foreground="{DynamicResource Muted}"/>
                        <ComboBox x:Name="EyeColorBox" Width="110"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,6">
                        <TextBlock Text="Favourite colour" Foreground="{DynamicResource Muted}"/>
                        <ComboBox x:Name="FavoriteColorBox" Width="125"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel Margin="0,2,0,0">
                    <Button x:Name="CreateBtn" Content="Create Mii" IsEnabled="False" Click="Create_Click"
                            ToolTip="Creates a new Mii in the offline draft."/>
                    <Button x:Name="ApplyBtn" Content="Apply changes" IsEnabled="False" Click="Apply_Click"
                            ToolTip="Updates the selected Mii in the offline draft."/>
                    <Button x:Name="SaveBtn" Content="Save to emulator" IsEnabled="False" Click="Save_Click"
                            ToolTip="Creates a verified backup and then saves this draft to the selected emulator."/>
                    <Button x:Name="DiscardBtn" Content="Discard changes" IsEnabled="False" Click="Discard_Click"/>
                </WrapPanel>
                <TextBlock Text="Style and colour numbers are the emulator’s own IDs; their visual order differs between Wii and Switch."
                           Foreground="{DynamicResource Muted}" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ListView x:Name="MiiList" Grid.Row="3" SelectionChanged="MiiList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Slot" Width="70" DisplayMemberBinding="{Binding Slot}"/>
                    <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Mii / UUID" Width="330" DisplayMemberBinding="{Binding Id}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Expander Grid.Row="4" Header="Backup, restore, import and export" Margin="0,10,0,0">
            <DockPanel Margin="0,8,0,0">
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BackupBtn" Content="Backup now" Click="Backup_Click"/>
                    <Button x:Name="ExportBtn" Content="Export selected Mii…" Click="Export_Click"/>
                    <Button x:Name="ExportDatabaseBtn" Content="Export database…" Click="ExportDatabase_Click"/>
                    <Button x:Name="ImportBtn" Content="Import a Mii…" IsEnabled="False" Click="Import_Click"
                            ToolTip="Imports an exact compatible Mii record into the offline draft."/>
                    <CheckBox x:Name="UnknownProcessBox" Content="I accept an unavailable process check"
                              VerticalAlignment="Center" Margin="12,0,0,0"
                              ToolTip="Only use after manually confirming the emulator is closed."/>
                </WrapPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="BackupBox" Width="420" DisplayMemberPath="Manifest.TimestampUtc"
                              SelectionChanged="BackupBox_SelectionChanged"/>
                    <Button x:Name="RestoreBtn" Content="Restore verified backup…" Click="Restore_Click"/>
                </StackPanel>
            </DockPanel>
        </Expander>
    </Grid>
</UserControl>
