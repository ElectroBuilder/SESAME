<UserControl x:Class="Sesame.MiiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sesame">
    <UserControl.Resources>
        <DataTemplate x:Key="ChoiceTemplate">
            <Border Width="154" Height="126" Margin="6" Padding="5"
                    Background="{DynamicResource Bg}" CornerRadius="8"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource PanelAlt}" CornerRadius="5" Padding="2">
                        <Image Source="{Binding Thumbnail}" Width="140" Height="92" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="2,4,2,0">
                        <Border Width="11" Height="11" Background="{Binding Swatch}" CornerRadius="2" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{DynamicResource Bg}" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="TargetBox" Width="220" SelectionChanged="TargetBox_SelectionChanged">
                <ComboBoxItem Tag="Wii">Dolphin · Wii Mii database</ComboBoxItem>
                <ComboBoxItem Tag="Eden">Eden · Switch Mii database</ComboBoxItem>
            </ComboBox>
            <Button x:Name="RefreshBtn" Content="Refresh" Click="Refresh_Click"/>
        </StackPanel>

        <!-- Kept collapsed because the code uses these controls for diagnostics
             and verified path selection, but the editor no longer exposes the
             capability/status banner in the normal layout. -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="CapabilityText"/>
            <TextBlock x:Name="IntegrityText"/>
            <TextBlock x:Name="PathText"/>
            <ComboBox x:Name="DatabasePathBox" DisplayMemberPath="Path"
                      SelectionChanged="DatabasePathBox_SelectionChanged"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Mii maker" FontWeight="SemiBold"/>
                <TextBlock DockPanel.Dock="Top"
                           Text="Select a Mii on the left, then choose the real face parts. Changes stay in a draft until saved."
                           Foreground="{DynamicResource Muted}" Margin="0,3,0,8" TextWrapping="Wrap"/>

                <Grid MinHeight="500">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="MiiList" Grid.Row="0" SelectionChanged="MiiList_SelectionChanged"
                                 VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                                 KeyboardNavigation.DirectionalNavigation="Cycle"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2" Padding="5" CornerRadius="8"
                                            Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="92" Height="92" Background="{DynamicResource PanelAlt}"
                                                    CornerRadius="6">
                                                <Image Source="{Binding Image}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                            <Button Content="＋ Mii" Click="CreateMiiCard_Click"
                                ToolTip="Add a simple Mii to the draft."/>
                            <Button x:Name="DeleteBtn" Content="Delete Mii" Click="Delete_Click"
                                    IsEnabled="False" Margin="7,0,0,0"
                                    ToolTip="Remove the selected Mii from the draft."/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <local:MiiAvatarControl x:Name="AvatarPreview" Height="275" MinWidth="320"
                                                VerticalAlignment="Top"/>
                        <TextBlock x:Name="FflPreviewText" Text="Rendering real Mii preview…"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"
                                   Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Name" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
                        <TextBox x:Name="NameBox" MaxLength="10" TextChanged="EditorTextChanged"/>
                        <TextBlock Text="Gender" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,7">
                            <RadioButton x:Name="MaleRadio" Content="Male" GroupName="MiiGender" IsChecked="True"
                                         Margin="0,0,12,0" Checked="GenderChanged"/>
                            <RadioButton x:Name="FemaleRadio" Content="Female" GroupName="MiiGender"
                                         Checked="GenderChanged"/>
                        </StackPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Randomize" Click="Randomize_Click" ToolTip="Choose a complete random valid Mii."/>
                            <Button x:Name="ApplyBtn" Content="Apply changes" IsEnabled="False" Click="Apply_Click"/>
                            <Button x:Name="SaveBtn" Content="Save to emulator" IsEnabled="False" Click="Save_Click"/>
                            <Button x:Name="DiscardBtn" Content="Discard changes" IsEnabled="False" Click="Discard_Click"/>
                        </WrapPanel>
                        <Button x:Name="CreateBtn" Visibility="Collapsed" IsEnabled="False" Click="Create_Click"/>
                    </StackPanel>

                    <TabControl Grid.Column="2" Margin="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <TabItem Header="Hair">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="3">
                                    <TextBlock Text="Hair style" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                                    <ListBox x:Name="HairGallery" Height="190" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Hair colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="HairColorGallery" Height="190" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Eyes">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="3">
                                    <TextBlock Text="Eyes" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                                    <ListBox x:Name="EyeGallery" Height="170" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Eye colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="EyeColorGallery" Height="170" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Eyebrows" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="EyebrowGallery" Height="170" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Eyebrow colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="EyebrowColorGallery" Height="170" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Glasses" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="GlassesGallery" Height="170" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Glasses colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="GlassesColorGallery" Height="170" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Face">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="3">
                                    <TextBlock Text="Face shape" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                                    <ListBox x:Name="FaceGallery" Height="170" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Nose" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="NoseGallery" Height="170" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Mouth" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="MouthGallery" Height="170" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Mouth colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="MouthColorGallery" Height="170" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Beard" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="BeardGallery" Height="170" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Beard colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="BeardColorGallery" Height="170" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Misc">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="3">
                                    <TextBlock Text="Mole" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                                    <ListBox x:Name="MoleGallery" Height="190" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Skin colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="FaceColorGallery" Height="190" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                    <TextBlock Text="Favourite colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                    <ListBox x:Name="FavoriteColorGallery" Height="190" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </DockPanel>
        </Border>

        <Expander Grid.Row="2" Header="Backup, restore, import and export" Margin="0,0,0,0">
            <DockPanel Margin="0,8,0,0">
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BackupBtn" Content="Backup now" Click="Backup_Click"/>
                    <Button x:Name="ExportBtn" Content="Export selected Mii…" Click="Export_Click"/>
                    <Button x:Name="ExportDatabaseBtn" Content="Export database…" Click="ExportDatabase_Click"/>
                    <Button x:Name="ImportBtn" Content="Import a Mii…" IsEnabled="False" Click="Import_Click"/>
                    <CheckBox x:Name="UnknownProcessBox" Content="I accept an unavailable process check"
                              VerticalAlignment="Center" Margin="12,0,0,0"/>
                </WrapPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="BackupBox" Width="420" DisplayMemberPath="Manifest.TimestampUtc"
                              SelectionChanged="BackupBox_SelectionChanged"/>
                    <Button x:Name="RestoreBtn" Content="Restore verified backup…" Click="Restore_Click"/>
                </StackPanel>
            </DockPanel>
        </Expander>
    </Grid>
</UserControl>
