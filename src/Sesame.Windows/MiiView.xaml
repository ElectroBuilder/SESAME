<UserControl x:Class="Sesame.MiiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sesame">
    <UserControl.Resources>
        <DataTemplate x:Key="ChoiceTemplate">
            <Border Width="154" Height="126" Margin="6" Padding="5"
                    Background="{DynamicResource Bg}" CornerRadius="8"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource PanelAlt}" CornerRadius="5" Padding="2">
                        <Image Source="{Binding Thumbnail}" Width="140" Height="92" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="2,4,2,0">
                        <Border Width="11" Height="11" Background="{Binding Swatch}" CornerRadius="2" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="GenderToggleStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{DynamicResource Bg}" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kept collapsed because the code uses these controls for diagnostics
             and verified path selection, but the editor no longer exposes the
             capability/status banner in the normal layout. -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="CapabilityText"/>
            <TextBlock x:Name="IntegrityText"/>
            <TextBlock x:Name="PathText"/>
            <ComboBox x:Name="DatabasePathBox" DisplayMemberPath="Path"
                      SelectionChanged="DatabasePathBox_SelectionChanged"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Mii maker" FontWeight="SemiBold"/>
                <TextBlock DockPanel.Dock="Top"
                           Text="Select a Mii on the left, then choose the real face parts. Changes stay in a draft until saved."
                           Foreground="{DynamicResource Muted}" Margin="0,3,0,8" TextWrapping="Wrap"/>

                <Grid MinHeight="500">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="MiiList" Grid.Row="0" SelectionChanged="MiiList_SelectionChanged"
                                 VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                                 KeyboardNavigation.DirectionalNavigation="Cycle"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2" Padding="5" CornerRadius="8"
                                            Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="92" Height="92" Background="{DynamicResource PanelAlt}"
                                                    CornerRadius="6">
                                                <Image Source="{Binding Image}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,0">
                            <Button Content="＋ Mii" Click="CreateMiiCard_Click"
                                ToolTip="Add a simple Mii to the draft."/>
                            <Button x:Name="DeleteBtn" Content="Delete Mii" Click="Delete_Click"
                                    IsEnabled="False" Margin="7,0,0,0"
                                    ToolTip="Remove the selected Mii from the draft."/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <local:MiiAvatarControl x:Name="AvatarPreview" Height="275" MinWidth="320"
                                                VerticalAlignment="Top"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="TargetBox" Width="220" SelectionChanged="TargetBox_SelectionChanged">
                                <ComboBoxItem Tag="Wii">Dolphin · Wii Mii database</ComboBoxItem>
                                <ComboBoxItem Tag="Eden">Eden · Switch Mii database</ComboBoxItem>
                            </ComboBox>
                            <Button x:Name="RefreshBtn" Content="Refresh" Click="Refresh_Click"/>
                        </StackPanel>
                        <TextBlock Text="Name" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
                        <TextBox x:Name="NameBox" MaxLength="10" TextChanged="EditorTextChanged"/>
                        <TextBlock Text="Gender" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
                        <Grid Margin="0,2,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="MaleRadio" Grid.Column="0" Content="Male" GroupName="MiiGender" IsChecked="True"
                                         Style="{StaticResource GenderToggleStyle}"
                                         Height="30" HorizontalContentAlignment="Center" Checked="GenderChanged"/>
                            <RadioButton x:Name="FemaleRadio" Grid.Column="1" Content="Female" GroupName="MiiGender"
                                         Style="{StaticResource GenderToggleStyle}"
                                         Height="30" HorizontalContentAlignment="Center" Checked="GenderChanged"/>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Content="Randomize" Height="32" Margin="0,0,4,4" Click="Randomize_Click" ToolTip="Choose a complete random valid Mii."/>
                            <Button x:Name="ApplyBtn" Grid.Row="0" Grid.Column="1" Content="Apply changes" Height="32" Margin="4,0,0,4" IsEnabled="False" Click="Apply_Click"/>
                            <Button x:Name="SaveBtn" Grid.Row="1" Grid.Column="0" Content="Save to emulator" Height="32" Margin="0,4,4,0" IsEnabled="False" Click="Save_Click"/>
                            <Button x:Name="DiscardBtn" Grid.Row="1" Grid.Column="1" Content="Discard changes" Height="32" Margin="4,4,0,0" IsEnabled="False" Click="Discard_Click"/>
                        </Grid>
                        <Button x:Name="CreateBtn" Visibility="Collapsed" IsEnabled="False" Click="Create_Click"/>
                    </StackPanel>

                    <TabControl Grid.Column="2" Margin="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <TabItem Header="Hair">
                            <Grid Margin="3">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Hair style" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                                <ListBox x:Name="HairGallery" Grid.Row="1" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="2" Text="Hair colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
                                <ListBox x:Name="HairColorGallery" Grid.Row="3" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Eyes">
                            <Grid Margin="3">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Eyes" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="EyeGallery" Grid.Row="1" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="2" Text="Eye colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="EyeColorGallery" Grid.Row="3" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="4" Text="Eyebrows" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="EyebrowGallery" Grid.Row="5" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="6" Text="Eyebrow colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="EyebrowColorGallery" Grid.Row="7" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="8" Text="Glasses" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="GlassesGallery" Grid.Row="9" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="10" Text="Glasses colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="GlassesColorGallery" Grid.Row="11" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Face">
                            <Grid Margin="3">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Face shape" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="FaceGallery" Grid.Row="1" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="2" Text="Nose" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="NoseGallery" Grid.Row="3" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="4" Text="Mouth" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="MouthGallery" Grid.Row="5" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="6" Text="Mouth colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="MouthColorGallery" Grid.Row="7" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="8" Text="Beard" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="BeardGallery" Grid.Row="9" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="10" Text="Beard colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="BeardColorGallery" Grid.Row="11" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Misc">
                            <Grid Margin="3">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Mole" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="MoleGallery" Grid.Row="1" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="2" Text="Skin colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="FaceColorGallery" Grid.Row="3" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                                <TextBlock Grid.Row="4" Text="Favourite colour" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ListBox x:Name="FavoriteColorGallery" Grid.Row="5" Tag="4" ItemTemplate="{StaticResource ChoiceTemplate}" SelectionChanged="EditorValueChanged" PreviewKeyDown="ChoiceGallery_PreviewKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </DockPanel>
        </Border>

        <Expander Grid.Row="2" Header="Backup, restore, import and export" Margin="0,0,0,0">
            <DockPanel Margin="0,8,0,0">
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BackupBtn" Content="Backup now" Click="Backup_Click"/>
                    <Button x:Name="ExportBtn" Content="Export selected Mii…" Click="Export_Click"/>
                    <Button x:Name="ExportDatabaseBtn" Content="Export database…" Click="ExportDatabase_Click"/>
                    <Button x:Name="ImportBtn" Content="Import a Mii…" IsEnabled="False" Click="Import_Click"/>
                    <CheckBox x:Name="UnknownProcessBox" Content="I accept an unavailable process check"
                              VerticalAlignment="Center" Margin="12,0,0,0"/>
                </WrapPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="BackupBox" Width="420" DisplayMemberPath="Manifest.TimestampUtc"
                              SelectionChanged="BackupBox_SelectionChanged"/>
                    <Button x:Name="RestoreBtn" Content="Restore verified backup…" Click="Restore_Click"/>
                </StackPanel>
            </DockPanel>
        </Expander>
    </Grid>
</UserControl>
