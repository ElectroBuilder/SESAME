<UserControl x:Class="Sesame.MiiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{DynamicResource Bg}" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="TargetBox" Width="220" SelectionChanged="TargetBox_SelectionChanged">
                <ComboBoxItem Tag="Wii">Dolphin · Wii Mii database</ComboBoxItem>
                <ComboBoxItem Tag="Eden">Eden · Switch Mii database</ComboBoxItem>
            </ComboBox>
            <Button x:Name="RefreshBtn" Content="Refresh" Click="Refresh_Click"/>
            <Button x:Name="BackupBtn" Content="Backup now" Click="Backup_Click"/>
            <CheckBox x:Name="UnknownProcessBox" Content="I accept an unavailable process check"
                      VerticalAlignment="Center" Margin="12,0,0,0"
                      ToolTip="Only use after manually confirming the emulator is closed."/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,10">
            <StackPanel>
                <TextBlock x:Name="CapabilityText" FontWeight="SemiBold"/>
                <TextBlock x:Name="IntegrityText" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="PathText" Margin="0,4,0,0" Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap"/>
                <ComboBox x:Name="DatabasePathBox" Margin="0,7,0,0" DisplayMemberPath="Path"
                          SelectionChanged="DatabasePathBox_SelectionChanged" Visibility="Collapsed"
                          ToolTip="Choose the emulator database SESAME may read and, after opt-in, replace."/>
            </StackPanel>
        </Border>

        <ListView x:Name="MiiList" Grid.Row="2" SelectionChanged="MiiList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Slot" Width="70" DisplayMemberBinding="{Binding Slot}"/>
                    <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Mii / UUID" Width="330" DisplayMemberBinding="{Binding Id}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBox x:Name="NameBox" Width="150" Margin="0,0,4,0" MaxLength="10"
                         ToolTip="Select a Mii, edit its name here and save it to the draft."/>
                <Button x:Name="RenameBtn" Content="Rename in draft" Click="Rename_Click"/>
                <Button x:Name="ExportBtn" Content="Export exact record…" Click="Export_Click"/>
                <Button x:Name="ExportDatabaseBtn" Content="Export draft/database…" Click="ExportDatabase_Click"/>
                <Button x:Name="ImportBtn" Content="Import into draft…" IsEnabled="False" Click="Import_Click"
                        ToolTip="Adds an exact .mii/.miigx record to the offline draft; live NAND is unchanged."/>
                <Button x:Name="BasicBtn" Content="New basic in draft…" IsEnabled="False" Click="Basic_Click"
                        ToolTip="Creates a named basic Mii in the offline draft; live NAND is unchanged."/>
                <Button x:Name="DiscardBtn" Content="Discard draft" IsEnabled="False" Click="Discard_Click"/>
                <CheckBox x:Name="ExperimentalPushBox" Content="Enable experimental Push" Checked="ExperimentalPushBox_Changed" Unchecked="ExperimentalPushBox_Changed"
                          VerticalAlignment="Center" Margin="8,0,4,0"
                          ToolTip="Requires an explicit acknowledgement. SESAME backs up the live database before replacing it."/>
                <Button x:Name="PushBtn" Content="Push draft…" IsEnabled="False" Click="Push_Click"
                        ToolTip="Experimental: validates, backs up and atomically replaces the selected emulator database."/>
            </WrapPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox x:Name="BackupBox" Width="420" DisplayMemberPath="Manifest.TimestampUtc"
                          SelectionChanged="BackupBox_SelectionChanged"/>
                <Button x:Name="RestoreBtn" Content="Restore verified backup…" Click="Restore_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
