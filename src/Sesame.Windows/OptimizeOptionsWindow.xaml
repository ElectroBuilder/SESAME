<Window x:Class="Sesame.OptimizeOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimaliseren"
        Icon="pack://application:,,,/Assets/sesame-taskbar.ico"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">
    <StackPanel Margin="20" Width="520">
        <TextBlock FontWeight="SemiBold" FontSize="15" Text="Opties voordat het begint"/>
        <TextBlock x:Name="CountText" Foreground="{DynamicResource Muted}" Margin="0,6,0,14" TextWrapping="Wrap"/>
        <CheckBox x:Name="OverwriteBox" Content="Bestaande shortcuts bijwerken" Margin="0,0,0,8"/>
        <CheckBox x:Name="ArtworkBox" Content="Artwork overschrijven" Margin="0,0,0,8"
                  ToolTip="Bestaande Steam-covers vervangen. Ongewijzigde bestanden worden overgeslagen."/>
        <CheckBox x:Name="MaskBox" Content="Categoriemaskers gebruiken"
                  ToolTip="Masterschakelaar. Per platform (Hydra standaard uit) zet je maskers in Instellingen → Covers."/>
        <TextBlock x:Name="GyroNote" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"
                   Visibility="Collapsed"/>
        <TextBlock x:Name="SteamNote" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,16,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Annuleren" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Starten" Style="{StaticResource AccentButton}" IsDefault="True"
                    Click="Start_Click" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
