<Window x:Class="Sesame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sesame"
        Title="SESAME"
        Height="820" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/sesame-taskbar.ico"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BrandBar}" Padding="16,12"
                BorderBrush="{DynamicResource BrandAccent}" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Image Width="72" Height="72" Margin="0,0,16,0"
                           Source="pack://application:,,,/Assets/sesame-icon-lg.png" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SESAME" FontWeight="Bold" FontSize="32" FontFamily="Segoe UI"
                                       Foreground="{DynamicResource BrandAccent}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VersionText" Text="v0.0.0" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Gold}" VerticalAlignment="Bottom" Margin="12,0,0,5"/>
                        </StackPanel>
                        <TextBlock Text="STEAM DECK SHORTCUT &amp; ARTWORK MANAGER"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Gold}"
                                   Margin="0,4,0,0" Opacity="0.9"/>
                    </StackPanel>
                </StackPanel>
                <ComboBox x:Name="ProfileBox" Grid.Column="1" DisplayMemberPath="Name"
                          VerticalAlignment="Center" Height="34" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Sessions…" Style="{StaticResource ChromeButton}" Click="Sessions_Click"
                        VerticalAlignment="Center" Height="34" MinHeight="34" MaxHeight="34"
                        ToolTip="Create, edit and save sessions"/>
                <Button x:Name="ConnectBtn" Grid.Column="3" Content="Connect" Style="{StaticResource AccentButton}"
                        VerticalAlignment="Center" Height="34" MinHeight="34" MaxHeight="34" Click="Connect_Click"/>
                <Button x:Name="DisconnectBtn" Grid.Column="4" Content="Disconnect" Style="{StaticResource ChromeButton}"
                        VerticalAlignment="Center" Height="34" MinHeight="34" MaxHeight="34"
                        Click="Disconnect_Click" IsEnabled="False"/>
                <TextBlock x:Name="StatusText" Grid.Column="5" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource BrandMuted}" Text="Not connected"/>
                <Button x:Name="TermToggleBtn" Grid.Column="6" Content="Hide terminal" Style="{StaticResource ChromeButton}"
                        VerticalAlignment="Center" Height="34" MinHeight="34" MaxHeight="34" Click="TermToggle_Click"
                        ToolTip="Show or hide the terminal"/>
                <Button Grid.Column="7" Content="Install…" Style="{StaticResource ChromeButton}"
                        VerticalAlignment="Center" Height="34" MinHeight="34" MaxHeight="34" Click="Install_Click"
                        ToolTip="Send a ROM, mod or texture pack to the right folder"/>
                <Button Grid.Column="8" Content="Settings" Style="{StaticResource ChromeButton}"
                        VerticalAlignment="Center" Height="34" MinHeight="34" MaxHeight="34" Click="Settings_Click"
                        ToolTip="Theme, SteamGridDB key and emulators"/>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="FooterText" Foreground="{DynamicResource Muted}"
                           Text="Drop files here to upload them to the current folder or a game."/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="TermSplitRow" Height="6"/>
                <RowDefinition x:Name="TermRow" Height="220"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Background="{DynamicResource Panel}">
                    <TextBlock DockPanel.Dock="Top" Text="Quick access" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Margin="12,10,12,6"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,8">
                        <Button Content="Pin current folder" Click="PinCurrent_Click"
                                ToolTip="Add the open folder to quick access"/>
                    </StackPanel>
                    <TreeView x:Name="QuickTree" SelectedItemChanged="QuickTree_Selected"
                              PreviewMouseRightButtonDown="QuickTree_RightDown">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Click="QuickOpen_Click"/>
                                <MenuItem Header="Unpin" Click="QuickUnpin_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource Bg}"/>

                <TabControl Grid.Column="2" x:Name="MainTabs">
                    <TabItem Header="Files">
                        <DockPanel Background="{DynamicResource Bg}">
                            <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="8,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Back" Click="Back_Click"/>
                                    <Button Content="Up" Click="Up_Click"/>
                                    <Button Content="Refresh" Click="Refresh_Click"/>
                                    <Button Content="New folder" Click="NewFolder_Click"/>
                                    <Button Content="Open" Click="Open_Click"/>
                                    <Button Content="Download" Click="Download_Click"/>
                                    <Button Content="Delete" Click="Delete_Click"/>
                                    <TextBox x:Name="PathBox" Width="380" Margin="4,0,8,0" KeyDown="PathBox_KeyDown"/>
                                    <Button Content="Go" Click="Go_Click"/>
                                </StackPanel>
                            </Border>
                            <ListView x:Name="FileList"
                                      SelectionMode="Extended"
                                      MouseDoubleClick="FileList_DoubleClick"
                                      PreviewMouseRightButtonDown="FileList_RightDown"
                                      PreviewKeyDown="FileList_PreviewKeyDown"
                                      ContextMenuOpening="FileList_ContextMenuOpening"
                                      AllowDrop="True"
                                      Drop="Window_Drop"
                                      DragOver="Window_DragOver">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="" Width="36">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="18" Foreground="{DynamicResource Accent}"
                                                               VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Name" Width="380">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text}"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="11"
                                                                   Foreground="{DynamicResource Muted}"
                                                                   Visibility="{Binding HasAlias, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Kind}"/>
                                        <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                                        <GridViewColumn Header="Modified" Width="160" DisplayMemberBinding="{Binding LastWrite}"/>
                                    </GridView>
                                </ListView.View>
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" InputGestureText="Enter" Click="Open_Click"/>
                                        <MenuItem x:Name="RunOnDeckItem" Header="Run in terminal" Click="RunOnDeck_Click"
                                                  ToolTip="Runs the script on the Steam Deck and shows output below"/>
                                        <MenuItem Header="Download to Downloads" InputGestureText="Ctrl+S" Click="Download_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Rename" InputGestureText="F2" Click="Rename_Click"/>
                                        <MenuItem Header="Delete" InputGestureText="Del" Click="Delete_Click"/>
                                        <MenuItem Header="New folder" InputGestureText="Ctrl+N" Click="NewFolder_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Pin to quick access" InputGestureText="Ctrl+D" Click="PinSelected_Click"/>
                                        <MenuItem Header="Copy path" InputGestureText="Ctrl+C" Click="CopyPath_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Games">
                        <DockPanel Background="{DynamicResource Bg}">
                            <Border DockPanel.Dock="Top" Background="{DynamicResource PanelAlt}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="8,6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Scan library" Click="ScanGames_Click"/>
                                    <Button Content="Open ROM folder" Click="OpenRom_Click"/>
                                    <Button Content="Open mods" Click="OpenMods_Click"/>
                                    <Button Content="Open saves" Click="OpenSaves_Click"/>
                                    <Button Content="Open texture packs" Click="OpenTextures_Click"/>
                                    <Button Content="Install mod…" Click="InstallMod_Click"/>
                                    <Button Content="To Dutch…" Click="TranslateDutch_Click"
                                            ToolTip="Dutch text patch for an N64, NES or SNES ROM. The original file stays."/>
                                    <Button Content="Search packs…" Style="{StaticResource AccentButton}" Click="SearchPacks_Click"/>
                                </StackPanel>
                            </Border>
                            <ListView x:Name="GameList"
                                      PreviewMouseRightButtonDown="GameList_RightDown"
                                      MouseDoubleClick="OpenRom_Click"
                                      ContextMenuOpening="GameList_ContextMenuOpening">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Game" Width="240" DisplayMemberBinding="{Binding DisplayName}"/>
                                        <GridViewColumn Header="File name" Width="260" DisplayMemberBinding="{Binding FileNameText}"/>
                                        <GridViewColumn Header="System" Width="80" DisplayMemberBinding="{Binding System}"/>
                                        <GridViewColumn Header="Kind" Width="90" DisplayMemberBinding="{Binding KindText}"/>
                                        <GridViewColumn Header="Title ID" Width="150" DisplayMemberBinding="{Binding TitleIdText}"/>
                                        <GridViewColumn Header="Mods" Width="60" DisplayMemberBinding="{Binding ModsText}"/>
                                        <GridViewColumn Header="Saves" Width="60" DisplayMemberBinding="{Binding SavesText}"/>
                                        <GridViewColumn Header="Account" Width="110" DisplayMemberBinding="{Binding SaveAccountName}"/>
                                        <GridViewColumn Header="Path" Width="320" DisplayMemberBinding="{Binding RomPath}"/>
                                    </GridView>
                                </ListView.View>
                                <ListView.ContextMenu>
                                    <ContextMenu x:Name="GameMenu"/>
                                </ListView.ContextMenu>
                            </ListView>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Game Optimizer">
                        <local:GameOptimizerView x:Name="OptimizerPanel"/>
                    </TabItem>
                    <TabItem Header="Store">
                        <local:StoreView x:Name="StorePanel"/>
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter x:Name="TermSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource Bg}"/>

            <DockPanel x:Name="TermPanel" Grid.Row="2" Background="{DynamicResource Panel}">
                <DockPanel DockPanel.Dock="Top" Margin="10,6,8,4">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Script…" Click="TermScript_Click"
                                ToolTip="Send a local script (.sh, .py, …) to the Deck and run it there"/>
                        <Button Content="Ctrl+C" Click="TermInterrupt_Click"
                                ToolTip="Interrupt the current command"/>
                        <Button Content="Clear" Click="TermClear_Click" Margin="0"
                                ToolTip="Clear the terminal"/>
                    </StackPanel>
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="Terminal"/>
                        <Run x:Name="TermHint" Text="  ·  click here and type a command" FontWeight="Normal"
                             Foreground="{DynamicResource Muted}"/>
                    </TextBlock>
                </DockPanel>
                <TextBox x:Name="TermBox"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13"
                         Background="{DynamicResource TermBg}"
                         Foreground="{DynamicResource TermFg}"
                         CaretBrush="{DynamicResource TermFg}"
                         BorderThickness="0"
                         Padding="10,6"
                         Margin="8,0,8,8"
                         IsUndoEnabled="False"
                         TextChanged="TermBox_TextChanged"
                         PreviewKeyDown="TermBox_PreviewKeyDown"
                         PreviewTextInput="TermBox_PreviewTextInput"
                         SizeChanged="TermBox_SizeChanged"
                         DataObject.Pasting="TermBox_Pasting"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
