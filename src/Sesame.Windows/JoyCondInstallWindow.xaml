<Window x:Class="Sesame.JoyCondInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install Joy-Con motion (Dolphin)"
        Width="640" Height="560" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ViewScriptBtn" Content="View script" Click="ViewScript_Click" Margin="0,0,8,0"/>
            <Button x:Name="RefreshBtn" Content="Refresh status" Click="Refresh_Click" Margin="0,0,8,0"/>
            <Button x:Name="InstallBtn" Content="Install on Deck" Style="{StaticResource AccentButton}"
                    Click="Install_Click" Margin="0,0,8,0"/>
            <Button Content="Close" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Dolphin · Joy-Con motion (joycond)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <TextBlock x:Name="StatusLine" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="Risks" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="RiskBox" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
                <TextBlock Text="Deck sudo password" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="SudoBox" Margin="0,0,0,4"/>
                <TextBlock Text="Not stored. Needed once for system install." Foreground="{DynamicResource Muted}"
                           FontSize="12" Margin="0,0,0,12"/>
                <CheckBox x:Name="RiskCheck" Content="I understand the risks and want to install joycond for Dolphin"
                          Margin="0,0,0,12"/>
                <TextBlock Text="Log" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="LogBox" Height="180" IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="11"
                         Background="{DynamicResource PanelAlt}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
