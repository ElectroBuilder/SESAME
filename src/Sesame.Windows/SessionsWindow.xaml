<Window x:Class="Sesame.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sessions — SESAME"
        Icon="pack://application:,,,/Assets/sesame-taskbar.ico"
        Height="720" Width="820"
        MinHeight="600" MinWidth="740"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Saved sessions" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Connect" Style="{StaticResource AccentButton}" Click="Connect_Click"/>
            <Button Content="Close" Click="Close_Click" IsCancel="True"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Sessions" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="New" Click="New_Click"/>
                    <Button Content="Delete" Click="Delete_Click"/>
                </StackPanel>
                <ListBox x:Name="SessionList" DisplayMemberPath="Name"
                         Background="{DynamicResource Panel}"
                         Foreground="{DynamicResource Text}"
                         BorderBrush="{DynamicResource Border}"
                         SelectionChanged="SessionList_SelectionChanged"
                         MouseDoubleClick="SessionList_DoubleClick"/>
            </DockPanel>

            <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Session name" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Text="Host / IP" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="HostBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2" Text="Port" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="PortBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="3" Text="User" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="UserBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="4" Text="Private key" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="KeyStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Muted}" Text="No key" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Import…" Click="BrowseKey_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Remove" Click="ClearKey_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                               Margin="0,0,0,12"
                               Text="Import the private key from your .ssh folder (steam_deck or id_ed25519), not the .pub file. SESAME stores an encrypted copy for this Windows account."/>

                    <TextBlock Grid.Row="6" Text="Passphrase" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Clear" Click="ClearPassphrase_Click" Margin="8,0,0,0"/>
                        <PasswordBox x:Name="PassphraseBox"
                                     ToolTip="Only if the private key itself is encrypted. Leave empty otherwise."/>
                    </DockPanel>
                    <TextBlock x:Name="PassphraseStatus" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" Margin="0,0,0,12" Text=""/>

                    <TextBlock Grid.Row="8" Text="Password" VerticalAlignment="Center" Margin="0,0,0,4"/>
                    <DockPanel Grid.Row="8" Grid.Column="1" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Clear" Click="ClearPassword_Click" Margin="8,0,0,0"/>
                        <PasswordBox x:Name="LoginPasswordBox"
                                     ToolTip="Optional. Only if the Deck logs in with a password instead of a key."/>
                    </DockPanel>
                    <TextBlock x:Name="PasswordStatus" Grid.Row="9" Grid.Column="1" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" Margin="0,0,0,12" Text=""/>

                    <TextBlock Grid.Row="10" Text="MAC address" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <StackPanel Grid.Row="10" Grid.Column="1">
                        <TextBox x:Name="MacBox" Margin="0,0,0,8"
                                 ToolTip="For Wake-on-LAN when the Deck is asleep. Filled in automatically after a successful connect."/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                   Text="Sessions stay in your Windows profile (%APPDATA%\SESAME). Keys and passwords are encrypted for this account (DPAPI) and are never shown. Host, user and MAC are not secrets. Wake-on-LAN uses the MAC if the Deck is asleep."/>
                    </StackPanel>

                    <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
