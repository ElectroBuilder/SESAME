<Window x:Class="Sesame.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sessies — SESAME"
        Icon="pack://application:,,,/Assets/sesame-taskbar.ico"
        Height="640" Width="760"
        MinHeight="540" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Opgeslagen sessies" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Verbinden" Style="{StaticResource AccentButton}" Click="Connect_Click"/>
            <Button Content="Sluiten" Click="Close_Click" IsCancel="True"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Sessies" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Nieuw" Click="New_Click"/>
                    <Button Content="Verwijderen" Click="Delete_Click"/>
                </StackPanel>
                <ListBox x:Name="SessionList" DisplayMemberPath="Name"
                         Background="{DynamicResource Panel}"
                         Foreground="{DynamicResource Text}"
                         BorderBrush="{DynamicResource Border}"
                         SelectionChanged="SessionList_SelectionChanged"
                         MouseDoubleClick="SessionList_DoubleClick"/>
            </DockPanel>

            <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sessienaam" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="1" Text="Host / IP" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="HostBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="2" Text="Poort" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="PortBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="3" Text="Gebruiker" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBox x:Name="UserBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="4" Text="Private key" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <DockPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Verwijderen" Click="ClearKey_Click" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Importeren…" Click="BrowseKey_Click"/>
                        <TextBlock x:Name="KeyStatus" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted}" Text="Geen sleutel"/>
                    </DockPanel>

                    <TextBlock Grid.Row="5" Text="Wachtwoordzin" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <DockPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Wissen" Click="ClearPassphrase_Click" Margin="8,0,0,0"/>
                        <PasswordBox x:Name="PassphraseBox"
                                     ToolTip="Leeg laten behoudt de opgeslagen wachtwoordzin. Typ alleen om te vervangen."/>
                    </DockPanel>
                    <TextBlock x:Name="PassphraseStatus" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                               Foreground="{DynamicResource Muted}" Margin="0,0,0,10" Text=""/>

                    <TextBlock Grid.Row="7" Text="Wachtwoord" VerticalAlignment="Center" Margin="0,0,0,10"/>
                    <DockPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Wissen" Click="ClearPassword_Click" Margin="8,0,0,0"/>
                        <PasswordBox x:Name="LoginPasswordBox"
                                     ToolTip="Optioneel, als de Deck geen key-login gebruikt. Typ alleen om op te slaan of te vervangen."/>
                    </DockPanel>
                    <TextBlock x:Name="PasswordStatus" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                               Foreground="{DynamicResource Muted}" Margin="0,0,0,8" Text=""/>

                    <TextBlock Grid.Row="9" Text="MAC-adres" VerticalAlignment="Top" Margin="0,0,0,10"/>
                    <DockPanel Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2">
                        <TextBox x:Name="MacBox" Margin="0,0,0,8"
                                 ToolTip="Voor Wake-on-LAN bij slaapstand. Wordt automatisch ingevuld na verbinden."/>
                        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                   Text="Sessies staan alleen in je Windows-profiel (%APPDATA%\SESAME). Sleutels, wachtwoorden en API-keys zijn versleuteld voor dit account (DPAPI) en worden niet in beeld getoond. Host, gebruiker en MAC zijn geen geheimen maar gaan niet mee de GitHub-repo in. Bij slaapstand wekt SESAME de Deck met Wake-on-LAN."/>
                    </DockPanel>

                    <StackPanel Grid.Row="10" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Opslaan" Style="{StaticResource AccentButton}" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
