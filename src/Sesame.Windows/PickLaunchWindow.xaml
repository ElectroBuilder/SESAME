<Window x:Class="Sesame.PickLaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose launch"
        Icon="pack://application:,,,/Assets/sesame-taskbar.ico"
        Width="640" Height="420"
        MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Use this launch" Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="HintText" TextWrapping="Wrap"
                       Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
            <ListBox x:Name="ChoiceList" DisplayMemberPath="Label"
                     MouseDoubleClick="Choice_DoubleClick"/>
        </DockPanel>
    </DockPanel>
</Window>
